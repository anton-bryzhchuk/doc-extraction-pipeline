# Copy to .env and fill in to enable the live (real-model) extractor and tests.
# Leave empty to run everything in deterministic mock mode.
ANTHROPIC_API_KEY=
LLM_MODEL=

# Database. Defaults to a local SQLite file when unset.
# For the docker-compose Postgres setup this is provided by the compose file.
DATABASE_URL=

# Mock extractor profile used by the API when processing uploads.
# One of: good, noisy, hallucinating, malformed
DOCPIPE_PROFILE=good
